# Copy to .env and fill in. Never commit .env.

# Encrypts LinkedIn cookies before they are stored. Required.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Where the SQLite file lives.
DB_PATH=data/keys.db

# A key that works the moment the app starts, before anyone calls /v1/auth.
# Useful for a demo key that must keep working after a redeploy.
# Leave these unset and no bootstrap key exists.
BOOTSTRAP_API_KEY=
BOOTSTRAP_LI_AT=
BOOTSTRAP_JSESSIONID=

# The full cookie header from a logged-in browser. Optional. Requests are
# more reliable with it than with li_at alone, because LinkedIn checks the
# whole cookie set on page routes.
BOOTSTRAP_COOKIE_HEADER=

# Caps that protect the LinkedIn account behind a key.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=300
